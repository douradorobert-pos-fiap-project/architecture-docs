{
  "name": "FIAP Oficina - Operacao dos microsservicos",
  "description": "Visao operacional baseada apenas nos eventos customizados ja emitidos pelos servicos. As consultas podem ficar sem dados se a ingestao New Relic ainda nao estiver ativa.",
  "permissions": "PRIVATE",
  "pages": [
    {
      "name": "Operacao",
      "description": "HTTP, mensageria e integracao de pagamento.",
      "widgets": [
        {
          "title": "Requisicoes HTTP por servico",
          "layout": {"column": 1, "row": 1, "width": 6, "height": 3},
          "linkedEntityGuids": null,
          "visualization": {"id": "viz.line"},
          "rawConfiguration": {
            "nrqlQueries": [{"accountId": 0, "query": "FROM HttpRequest SELECT count(*) AS 'Requests' FACET service TIMESERIES"}],
            "legend": {"enabled": true},
            "platformOptions": {"ignoreTimeRange": false}
          }
        },
        {
          "title": "Latencia HTTP p95 por servico (ms)",
          "layout": {"column": 7, "row": 1, "width": 6, "height": 3},
          "linkedEntityGuids": null,
          "visualization": {"id": "viz.line"},
          "rawConfiguration": {
            "nrqlQueries": [{"accountId": 0, "query": "FROM HttpRequest SELECT percentile(duration_ms, 95) AS 'p95 ms' FACET service TIMESERIES"}],
            "legend": {"enabled": true},
            "platformOptions": {"ignoreTimeRange": false}
          }
        },
        {
          "title": "Respostas HTTP 5xx (%) por servico",
          "layout": {"column": 1, "row": 4, "width": 6, "height": 3},
          "linkedEntityGuids": null,
          "visualization": {"id": "viz.line"},
          "rawConfiguration": {
            "nrqlQueries": [{"accountId": 0, "query": "FROM HttpRequest SELECT percentage(count(*), WHERE status_code >= 500) AS '5xx %' FACET service TIMESERIES"}],
            "legend": {"enabled": true},
            "platformOptions": {"ignoreTimeRange": false}
          }
        },
        {
          "title": "Mensagens consumidas com retry (receive_count > 1)",
          "layout": {"column": 7, "row": 4, "width": 6, "height": 3},
          "linkedEntityGuids": null,
          "visualization": {"id": "viz.line"},
          "rawConfiguration": {
            "nrqlQueries": [{"accountId": 0, "query": "FROM MessageConsumed SELECT count(*) AS 'Retries' WHERE receive_count > 1 FACET event_type TIMESERIES"}],
            "legend": {"enabled": true},
            "platformOptions": {"ignoreTimeRange": false}
          }
        },
        {
          "title": "Publicacao de mensagens por tipo",
          "layout": {"column": 1, "row": 7, "width": 6, "height": 3},
          "linkedEntityGuids": null,
          "visualization": {"id": "viz.line"},
          "rawConfiguration": {
            "nrqlQueries": [{"accountId": 0, "query": "FROM MessagePublished SELECT count(*) AS 'Published' FACET event_type TIMESERIES"}],
            "legend": {"enabled": true},
            "platformOptions": {"ignoreTimeRange": false}
          }
        },
        {
          "title": "Latencia p95 das chamadas Mercado Pago registradas (ms)",
          "layout": {"column": 7, "row": 7, "width": 6, "height": 3},
          "linkedEntityGuids": null,
          "visualization": {"id": "viz.line"},
          "rawConfiguration": {
            "nrqlQueries": [{"accountId": 0, "query": "FROM MercadoPagoRequest SELECT percentile(duration_ms, 95) AS 'p95 ms' FACET path TIMESERIES"}],
            "legend": {"enabled": true},
            "platformOptions": {"ignoreTimeRange": false}
          }
        }
      ]
    }
  ]
}
